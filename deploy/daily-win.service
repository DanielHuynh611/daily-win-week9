[Unit]
Description=Daily Win Week 9 application
Wants=network-online.target mysql.service
After=network-online.target mysql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/daily-win-week9
EnvironmentFile=/home/ubuntu/daily-win-week9/.env
ExecStart=/home/ubuntu/daily-win-week9/.venv/bin/gunicorn --workers 1 --threads 2 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - fullstack:create_app()
Restart=always
RestartSec=5
TimeoutStopSec=30
PrivateTmp=true

[Install]
WantedBy=multi-user.target
